# ──────────────────────────────────────────────
# OpenSearch
# ──────────────────────────────────────────────
OPENSEARCH_URL=<Enter your OpenSearch URL here>
OPENSEARCH_USERNAME=<Enter your OpenSearch username here>
OPENSEARCH_PASSWORD=<Enter your OpenSearch password here>
OPENSEARCH_INDEX_NAME=<Enter your OpenSearch index name here>
OPENSEARCH_CONNECT_TIMEOUT=5000
OPENSEARCH_SOCKET_TIMEOUT=30000

# ──────────────────────────────────────────────
# DeepSeek LLM
# ──────────────────────────────────────────────
DEEPSEEK_API_KEY=<Enter your LLM key here>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TEMPERATURE=0.3

# ──────────────────────────────────────────────
# Alert Settings
# ──────────────────────────────────────────────
ALERT_LOG_WINDOW_MINUTES=15
ALERT_COOLDOWN_SECONDS=300
ONCALL_DEFAULT_EMAIL=<Enter your on-call email here>
ALERT_FROM_EMAIL=<Enter your from email here>

# ──────────────────────────────────────────────
# Email (SMTP)
# ──────────────────────────────────────────────
SMTP_HOST=<Enter your SMTP host here>
SMTP_PORT=587
SMTP_USERNAME=<Enter your SMTP username here>
SMTP_PASSWORD=<Enter your SMTP password here>

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
SERVER_PORT=8080
